{
  "name": "listit",
  "version": "1.4.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "seed": "electron scripts/seed-sample.js",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint src/js/**/*.js",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Lino Soriano",
  "license": "ISC",
  "description": "Gestiona tu lista de anime, series y películas",
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.0.0",
    "happy-dom": "^14.12.3",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.0.0",
    "sharp": "^0.34.5",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.listit.app",
    "productName": "ListIt",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!lista_anime.xml",
      "!dist/**",
      "!scripts/**",
      "!tests/**",
      "!**/*.md",
      "!vitest.config.js",
      "!eslint.config.js",
      "!.prettierrc",
      "!src/img/icono.*",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/{base64-js,bl,buffer,chownr,decompress-response,deep-extend,detect-libc,end-of-stream,expand-template,fs-constants,github-from-package,ieee754,inherits,ini,mimic-response,minimist,mkdirp-classic,napi-build-utils,node-abi,once,prebuild-install,pump,rc,readable-stream,safe-buffer,semver,simple-concat,simple-get,string_decoder,strip-json-comments,tar-fs,tar-stream,tunnel-agent,util-deprecate,wrappy}/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/img/icono.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/img/icono.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/img/icono.png"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  }
}
